# --- Runtime ---
NODE_ENV=development
PORT=3001
# Orígenes permitidos para CORS (lista separada por comas). Nunca usar "*".
CORS_ORIGINS=http://localhost:5173
# Confiar en el primer proxy (poner 1 detrás de nginx/ingress, 0 en local)
TRUST_PROXY=0

# --- Datos ---
DATABASE_URL=postgresql://nexus:GENERATED_BY_SETUP@localhost:54330/nexusflow?schema=public
# Vacío = ejecución de workflows en proceso (sin BullMQ). Con Redis = cola persistente con reintentos.
REDIS_URL=redis://localhost:63800

# --- Secretos (OBLIGATORIOS en producción; generar con: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-32
# Clave AES-256 en base64 (32 bytes): openssl rand -base64 32
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Clave HMAC para la cadena de auditoría
AUDIT_HMAC_KEY=change-me-audit-hmac-key-change-me-32chars

# --- Servicio ML ---
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=change-me-ml-service-token-32-chars-min

# --- Seguridad de workflows (SSRF) ---
# Hosts permitidos para la acción HTTP (vacío = acciones HTTP deshabilitadas)
HTTP_ACTION_ALLOWLIST=
